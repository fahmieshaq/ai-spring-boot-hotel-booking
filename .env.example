# Template for .env - copy to ".env" and fill in real values.
# Real .env is gitignored; this example IS committed so every developer
# knows which variables the app needs.
DB_URL_DEV=jdbc:postgresql://<your-neon-dev-host>/neondb?sslmode=require&channelBinding=require
DB_USER_DEV=<username>
DB_PASSWORD_DEV=<password>
